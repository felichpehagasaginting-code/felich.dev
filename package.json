    "dotenv": "^17.4.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "i18next": "^26.0.8",
